rules_version = '2';

// Lexio Firestore security rules.
//
// Publish: Firebase console -> Firestore Database -> Rules -> paste -> Publish
//          (or `firebase deploy --only firestore:rules` if you add a firebase.json).
//
// The quiz generator (tools/quizgen) writes with the Admin SDK, which bypasses these rules,
// so clients only ever get read access to generated content.
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user progress (score, streak, case bests, Instagram handle). Owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Period leaderboards: leaderboards/{daily_YYYY-MM-DD | weekly_YYYY-Www | monthly_YYYY-MM}/entries/{uid}.
    // Anyone signed in can read; a user can only write their own entry.
    // NOTE: scores are written by the client, so a modified client could cheat. Closing that
    // needs server-side validation (e.g. a Cloud Function), not just rules.
    match /leaderboards/{period}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Community feed: read for signed-in users; create only as yourself; authors may delete their own
    // posts (used by in-app account deletion); no edits from clients.
    match /posts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // Workspaces are curated in the console; clients only read.
    match /workspaces/{id} {
      allow read: if request.auth != null;
    }

    // Generated content (tools/quizgen): read-only for clients.
    match /dailyQuizzes/{country}/days/{day} {
      allow read: if request.auth != null;
    }
    match /studySets/{country}/sets/{slug} {
      allow read: if request.auth != null;
    }

    // Everything else is closed.
  }
}
