<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Tag Pill -->
        <TextView
            android:id="@+id/tvCardTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Ceza Hukuku"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCardTag"
            android:layout_marginTop="8dp"
            tools:text="Kasten Adam Öldürmeye Teşebbüs"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Preview Text -->
        <TextView
            android:id="@+id/tvCardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCardTitle"
            android:layout_marginTop="6dp"
            tools:text="Sanık, tartışma sonrasında katılanı bıçakla yaralamıştır..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.1" />

        <!-- Metadata row -->
        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCardPreview"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Ref -->
            <TextView
                android:id="@+id/tvCardRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="📋 TCK m.81"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginEnd="16dp" />

            <!-- Duration -->
            <TextView
                android:id="@+id/tvCardDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="⏱ ~15 dk"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginEnd="16dp" />

            <!-- Difficulty -->
            <TextView
                android:id="@+id/tvCardDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="📊 Orta"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Arrow icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@id/metaRow"
            android:text="→"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
