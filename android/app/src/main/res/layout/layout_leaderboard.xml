<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_dark">

        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Lexio"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/logoText"
            android:layout_centerVertical="true"
            android:text="."
            android:textColor="@color/accent_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/leaderboard_title"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Tabs header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnTabDaily"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/tab_daily"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnTabWeekly"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/tab_weekly"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/transparent"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnTabMonthly"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/tab_monthly"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/transparent"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- Leaderboard RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />


    <!-- AdMob Banner -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-4674211063760769/4886149685" />

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/nav_bottom" />

</LinearLayout>
