<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Category Tag -->
        <TextView
            android:id="@+id/tvStudyCardCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Ceza Hukuku"
            android:textColor="@color/accent_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvStudyCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStudyCardCategory"
            android:layout_marginTop="8dp"
            tools:text="Suçun Unsurları ve Kast"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Short Description -->
        <TextView
            android:id="@+id/tvStudyCardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStudyCardTitle"
            android:layout_marginTop="6dp"
            tools:text="Kast ve taksir kavramları, aralarındaki farklar..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.1" />

        <!-- Read time badge -->
        <TextView
            android:id="@+id/tvStudyCardTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStudyCardDesc"
            android:layout_marginTop="12dp"
            tools:text="⏱ 5 dk okuma"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Arrow -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@id/tvStudyCardTime"
            android:text="@string/study_card_read_more"
            android:textColor="@color/accent_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
