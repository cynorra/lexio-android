<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationContainer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/card_bg"
    android:elevation="12dp">

    <LinearLayout
        android:id="@+id/navCases"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navCasesIcon"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_cases"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:id="@+id/navCasesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_cases"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navFeed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navFeedIcon"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_feed"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:id="@+id/navFeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_feed"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navWorkspace"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navWorkspaceIcon"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_workspace"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:id="@+id/navWorkspaceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_workspace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navStudy"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navStudyIcon"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_study"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:id="@+id/navStudyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_study"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navLeaderboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navLeaderboardIcon"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_leaderboard"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:id="@+id/navLeaderboardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_leaderboard"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/navProfileIcon"
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_profile"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <TextView
            android:id="@+id/navProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_profile"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
