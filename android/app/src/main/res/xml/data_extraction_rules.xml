<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules for Android 12+ (older versions use backup_rules.xml).

  Only the device preferences (language, theme, country) travel to a new device. The signed-in
  user's progress is re-read from Firestore after sign-in, and Firebase / WorkManager / Ads state
  must be recreated on the new install, so none of it is backed up. See backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="lexio_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="lexio_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
